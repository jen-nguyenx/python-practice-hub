{
  "name": "pyladder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PyLadder: CITS1401 Python practice app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "verify": "node scripts/verify-content.ts",
    "verify:check": "node scripts/verify-content.ts --check",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run typecheck && npm run test && npm run verify:check && npm run build"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "monaco-editor": "0.56.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "pyodide": "314.0.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
